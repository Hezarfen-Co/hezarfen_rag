# hezarfen_rag — OPERATÖR ORTAM DOSYASI ŞABLONU (sunucu: ~/hezarfen_rag/hezarfen_rag.env)
#
# Bu dosya ELLE yazılır (0600); hiçbir otomasyon oluşturmaz ya da ezmez.
# Deploy yalnız VARLIĞINI ve izinlerini denetler (bkz.
# deploy/hezarfen_rag_compose.service, .github/workflows/main.yml).
#
# İKİ KANAL (sağlayıcının sınırı, tercih değil):
#   * bu dosya  -> systemd `EnvironmentFile=` ile unit'in ORTAMINA girer,
#                  ayrıca konteynere compose `env_file:` ile geçer;
#   * deploy'daki CI aynı dosyayı satır satır ortama alır
#                  (compose'a giden TEK `--env-file` deploy sahipli stack.env'dir).
#
# SATIR BİÇİMİ — ÖLÇÜLMÜŞ TUZAK: düz `KEY=value` yaz, satır-İÇİ `#` yorum
# KOYMA. systemd `EnvironmentFile=` satır-içi yorumu KORUR ve değerin parçası
# yapar (dotenv'un aksine). Yalnız kendi satırında başlayan `#` yorumdur.
# `compose.yaml` şu anahtarları İNTERPOLASYONA sokar, bunlarda hiç şaşma:
#   BOOK_PATH, SINIF, DERS, HEZARFEN_NET, HEZARFEN_DATA_VOLUME
#   (diğerleri konteynerin İÇİNE env olarak girer ve orada okunur)
#
# Eksik zorunlu anahtar SESSİZCE geçilmez: servis açılışta REDDEDER
# (src/service/preflight.py) ve konteyner /health'i hiç cevaplamaz ->
# deploy kapısı rollback yapar. Elle denetim:
#   podman run --rm --env-file ~/hezarfen_rag/hezarfen_rag.env \
#     localhost/hezarfen_rag:current python -m src.service.preflight
#
# ------------------------------- ÜRETİCİ LLM -------------------------------
# OpenAI-uyumlu her sağlayıcı; KOD DEĞİŞMEZ. Anahtarın TEK adı LLM_API_KEY'tir
# (eski DEEPSEEK_API_KEY/NVIDIA_API_KEY adları ortamda görülürse servis REDDEDER).
LLM_API_KEY=
# Boş bırakılırsa varsayılan https://api.deepseek.com + deepseek-chat.
LLM_BASE_URL=
LLM_MODEL=
# Reasoning modelleri max_tokens'ın tamamını düşünmeye harcayıp BOŞ içerik
# döndürüyor (ölçüldü 2026-09-10): aşağıyı sağlayıcına göre doldur.
#   DeepSeek/Kimi/Muse   -> {"reasoning_effort": "none"}
#   NVIDIA Nemotron      -> {"chat_template_kwargs": {"thinking": false}}
LLM_EXTRA_JSON=

# ------------------------- GÖMME (embedding) SAĞLAYICISI -------------------
# DAĞITIM VARSAYILANI = api. Yerel yol (BGE-M3) 7,6 GiB'lik GPU'suz sunucuya
# sığmaz: ~2,2 GB indirme + CPU'da rerank 95,9 s (kapı O-05 p50 <= 6 s).
#
# YEREL YOLA DÖNÜŞ (yerel yol silinmedi; imaj KÜÇÜK olduğu için yığın volume'dan
# gelir). Sıra: (1) bir kez `bash deploy/provision_local_stack.sh` (pip imge
# İÇİNDE koşar), (2) aşağıdaki dört satırı yaz, (3) `systemctl --user restart
# hezarfen_rag_compose`. Workflow yok, derleme yok.
#   RAG_EMBED_PROVIDER=local
#   RAG_RERANK_PROVIDER=local
#   RAG_LOCAL_VENV=/local-stack/venv
#   RAG_LOCAL_MODELS_DIR=/models
# RAM UYARISI: yerel mod ~4,5 GB ister; 7,6 GiB'lik sunucuda backend+postgres+
# frontend+chatbot ile birlikte yaşamaz — "diğer servisleri kapat" modudur.
RAG_EMBED_PROVIDER=api
# VOYAGE (DAĞITIM SEÇİMİ) — OpenAI biçimli /v1/embeddings; tek fark `input_type`
# sözlüğü (Voyage `passage`ı 400 ile reddeder, kod `document` gönderir):
#   RAG_EMBED_PROVIDER=voyage
#   RAG_EMBED_API_BASE=https://api.voyageai.com/v1      (…/v1 ile BİTİR)
#   RAG_EMBED_MODEL=voyage-multilingual-2               (1024 boyut)
#   RAG_EMBED_API_KEY=<Voyage anahtarı>
#   RAG_RERANK_API_URL=https://api.voyageai.com/v1/rerank
#   RAG_RERANK_MODEL=rerank-3                           (yanıt biçimi `data[]`)
# ÜCRETSİZ KOTA: belgelenmiş, ÖLÇÜLMEMİŞ (sağlayıcının fiyatlandırma sayfası
# kendi içinde tutarsız) — doğrulama yeri panel kullanım/faturalama ekranıdır.
# COHERE (YEDEK YOL) — native /v2/embed; `input_type` UYUMLULUK KATMANINDA
# reddedildiği için ayrı uç nokta kullanılır:
#   RAG_EMBED_PROVIDER=cohere
#   RAG_EMBED_API_BASE=https://api.cohere.com/v2        (kod sonuna /embed ekler)
#   RAG_EMBED_MODEL=embed-multilingual-v3.0             (1024 boyut)
# BOYUT DEĞİŞMEZİ: indeks 1024'tür; `light` varyantı (384) seçilirse İLK
# gömme adıyla reddedilir (yeniden indeksleme gerekir).
# OpenAI-uyumlu /v1/embeddings tabanı (…/v1 ile BİTİR; kod /embeddings ekler).
RAG_EMBED_API_BASE=
RAG_EMBED_MODEL=
# Anahtar İKİ biçimde verilebilir (kodun gerçek mekanizması, ikinci yol yok):
#   RAG_EMBED_API_KEY=<değer>             doğrudan
#   RAG_EMBED_API_KEY_ENV=<DEĞİŞKEN>      dolaylı: <DEĞİŞKEN> okunur
# Dolaylı biçim, AYNI sağlayıcı anahtarını iki serviste paylaşmak içindir;
# o zaman aşağıdaki satırı BOŞ bırak ve yalnız RAG_EMBED_API_KEY_ENV yaz.
RAG_EMBED_API_KEY=
#RAG_EMBED_API_KEY_ENV=
# Zaman aşımı / toplu boy (isteğe bağlı; varsayılanlar 30 s / 32 metin).
#RAG_EMBED_TIMEOUT_S=30
#RAG_EMBED_BATCH=32

# --------------------------- RERANK SAĞLAYICISI ----------------------------
# DAĞITIM VARSAYILANI = api. İki sağlayıcı da bu yolla çalışır:
#   * Cohere: `results[].index + relevance_score`, sınır alanı `top_n`
#   * Voyage: `data[].index + relevance_score`, sınır alanı `top_k`
# İki biçim de kabul edilir; sınır alanının adı uç adından çözülür
# (`RAG_RERANK_TOP_K_PARAM` ile ezilebilir — yanlış ad 4xx'tir, ölçüldü).
RAG_RERANK_PROVIDER=api
# Uç noktanın TAMAMI (…/rerank ile biter; kod sonuna bir şey eklemez).
RAG_RERANK_API_URL=
RAG_RERANK_MODEL=
RAG_RERANK_API_KEY=
#RAG_RERANK_API_KEY_ENV=
# (İsteğe bağlı) sınır alanının adı; varsayılan uç adından çözülür.
#RAG_RERANK_TOP_K_PARAM=top_k

# ÇEKİMSERLİK KAPISI — NEDEN AÇIK (risk beyanı, süs değil):
# Ürünün fail-closed kanıt kapısı `contexts[0].score < abstain_score(0,30)`
# kuralıyla çalışır ve bu eşik YEREL BGE reranker'ın skor dağılımı üzerinde
# ölçüldü (EXP-017). API rerank skorları 0-1 olsa da aynı dağılım DEĞİLDİR
# (`calibrated_scores=False`) → eşiği taşımak kapıyı sessizce devre dışı
# bırakır ve ürün kitapta olmayan soruya da cevap üretmeye çalışır.
# Bu bayrak "riski biliyorum" beyanıdır; kapatmak için ya eşiği bu sağlayıcı
# için yeniden kalibre et (python -m src.eval.calibrate_abstain_cli) ya da
# RAG_ABSTAIN_SCORE=0 ile kapıyı bilerek kapat.
RAG_ALLOW_UNCALIBRATED_ABSTAIN=1

# ------------------------------- SERVİS GÜVENLİĞİ --------------------------
# Boş -> uçlar kimlik doğrulamasız (yalnız iç ağ). Backend çağırıyorsa DOLDUR.
RAG_SERVICE_TOKEN=
#RAG_RATE_LIMIT_PER_MIN=60
#RAG_ALLOWED_HOSTS=*
#RAG_REQUEST_TIMEOUT_S=60

# --------------------------------- KORPUS ---------------------------------
# OKUL SEGMENTİ ZORUNLU (kiracılık): <kök>/<okul-uuid>/<kasa>/<sınıf>/<ders>/kitap.pdf
# Yol KONTEYNER içidir: korpus HEZARFEN_DATA_VOLUME'den /app/data'ya bağlanır.
# Düzeni taşımayan yol açık hata verir (sessizce bir okula atfetmez).
# Canlı okul segmenti tireli uuid'dir. Aşağıdaki BOOK_PATH repo demo fixture adıdır (okul-a).
BOOK_PATH=/app/data/okul-a/lise/10/biyoloji/kitap.pdf
SINIF=10
DERS=biyoloji
# Çok-korpus: BOŞ bırakılırsa yalnız BOOK_PATH okunur. Liste verilirse ders
# süzgecidir (okullar DİSKTEN keşfedilir; "all" = süzgeç yok) ve sohbette ders
# `options.ders` ile seçilir. İlk soru korpus kurulana kadar
# `service_warming_up` döner, sonrakiler normaldir.
#RAG_CORPORA=10/biyoloji,10/kimya,10/cografya
# Demo/mülakat öncesi ısıtma; boş = tamamen tembel (12 dk sağır servis yerine).
#RAG_WARM_CORPORA=all
# BELLEK VALFİ — dağıtımda AÇ ve zarfı aşma: RSS korpus sayısıyla lineer
# büyür (ölçülen 0,53 GB / 10k chunk; compose mem_limit = 3072 MB).
RAG_MAX_CORPORA=2

# ----------------------------- İNDEKS ÖNBELLEĞİ (#75) ----------------------
# Containerfile varsayılanı /index; compose `rag-index` volume'ünü oraya bağlar.
# Bu dizin gömme vektörlerini tutar: konteyner yeniden yaratılsa bile AYNI
# korpus için gömme ATLANIR, yani restart'tan sonraki "hazırlanıyor" penceresi
# kapanır. Anahtar içerik+model türevlidir (PDF/model değişirse kendiliğinden
# ıskar). Boş bırakılırsa önbellek KAPALI olur (eski davranış).
#RAG_INDEX_CACHE=/index

# ---------------------------- QUIC KÖPRÜSÜ (hab/2) -------------------------
# Kardeş AI servisleri backend'e QUIC ile DİAL-IN eder ve yeteneklerini kaydeder.
# Adlar filo sözleşmesidir (AI_* = köprü, HEZARFEN_* = filo altyapısı).
# Boş bırakılırsa backend kaydı "unauthorized" ile reddeder ve servis sonsuz
# geri çekilme döngüsünde bekler — yani köprü HİÇ kurulmaz.
AI_SHARED_TOKEN=
AI_SERVICE_NAME=rag
AI_BRIDGE_HOST=hezarfen_backend
AI_BRIDGE_PORT=8090
AI_BACKEND_URL=http://hezarfen_backend:7656
AI_TLS_SERVER_NAME=localhost
# Boş -> TOFU: sertifika ilk görüşte öğrenilir ve her açılışta UYARI yazılır.
# Doldurulursa PINLENİR; uyuşmazlıkta bağlantı REDDEDİLİR (önerilen).
#AI_TLS_FINGERPRINT=
#AI_MAX_CONCURRENT=4
#AI_RECONNECT_SECS=3.0
#AI_RECONNECT_MAX_SECS=120.0
#LOG_LEVEL=info

# ---------------------------- FİLO ALTYAPISI -------------------------------
# Backend compose'unun yarattığı paylaşılan dış ağ (farklı adla kurulduysa yaz).
HEZARFEN_NET=hezarfen_backend_default
# Korpusun HOST'taki dizini -> konteynerde /app/data (salt-okunur).
# Göreli yol unit'in çalışma dizinine göredir (~/hezarfen_rag), yani `./data`
# = ~/hezarfen_rag/data. Mutlak yol da yazılabilir.
HEZARFEN_DATA_VOLUME=./data
