# Required for generation/evaluation. Fill locally; never commit real keys.
# NOT: anahtar ADLARI ASCII + bosluksuz olmali (kod os.environ'dan bu adlarla okur).
DEEPSEEK_API_KEY=
# Alternatif saglayici anahtari (NVIDIA NIM ucretsiz uc noktalar icin).
NVIDIA_API_KEY=

# --- Uretici LLM secimi (OpenAI-uyumlu her saglayici; KOD DEGISMEZ) ---
# Bos ise varsayilan: https://api.deepseek.com + deepseek-chat.
# Aday karsilastirmasi (EXP-009) icin ornek NVIDIA NIM ayari:
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_MODEL=moonshotai/kimi-k3
#   LLM_API_KEY=<nvapi-...>
#   LLM_EXTRA_JSON={"reasoning_effort": "none"}
# LLM_EXTRA_JSON her istek govdesine eklenir; reasoning modelleri aksi halde tum
# max_tokens butcesini dusunmeye harcayip BOS icerik donduruyor (olculdu 2026-09-10).
# Nemotron ailesi icin: LLM_EXTRA_JSON={"chat_template_kwargs": {"thinking": false}}
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_EXTRA_JSON=

# Optional OpenAI-compatible vision provider (set all three to enable).
VLM_API_KEY=
VLM_BASE_URL=
VLM_MODEL=

# HTTP service defaults
BOOK_PATH=data/lise/12/biyoloji/kitap.pdf
SINIF=12
DERS=biyoloji
HOST=127.0.0.1
PORT=8000
GOLDEN_PATH=tests/golden/golden_12bio_v1.json

# Optional machine-specific paths; uncomment after installing Tesseract.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# HF_HOME=C:/Users/YOUR_USER/.cache/huggingface

# --- Maliyet defteri + guvenlik olay kaydi (#49, KVKK) ---
# Maliyet defteri yolu. ESKIDEN sabit bir Windows yoluydu (C:/Users/w/...) ve
# Linux'ta calisma dizinine sizip repoya girebiliyordu. Varsayilan: ~/.hezarfen/cost
HEZARFEN_COST_VAULT=
# Guvenlik olay kaydi (zararli/injection kararlari). VARSAYILAN KAPALI --
# yol verilmezse hicbir sey yazilmaz (veri minimizasyonu). Yazilan kayitta
# SORGU METNI YOKTUR (yalniz uzunluk + kisa hash) ve dosya 0600 izinlidir.
HEZARFEN_AUDIT_PATH=
HEZARFEN_AUDIT_RETENTION_DAYS=30

# --- Parent genisletme (#39) ---
# eval ve servis AYNI degeri okur. Varsayilan 0 = uretimin bugunku davranisi.
# Gecmis olcumleri (parent ACIK) yeniden uretmek icin 1.
RAG_INCLUDE_PARENTS=0

# --- HTTP servis sertlestirmesi (#50, EXP-010/SEC-09 + OPS-13) ---
# Varsayilanlar GERIYE UYUMLU secildi (mevcut kurulum bozulmasin); uretimde
# en az RAG_SERVICE_TOKEN ve RAG_ALLOWED_HOSTS doldurulmalidir. Servis
# acilista eksik olanlari UYARI olarak yazar, /ready de makine-okunur raporlar.
RAG_SERVICE_TOKEN=              # bos -> kimlik dogrulama KAPALI (yalniz ic ag)
RAG_RATE_LIMIT_PER_MIN=60       # 0 -> kapali. Surec-ici; cok-pod'da ters vekil sart
RAG_MAX_BODY_BYTES=262144       # ham govde siniri (ayristirmadan ONCE), 0 -> kapali
RAG_REQUEST_TIMEOUT_S=60        # istek basina son tarih; saglayici timeout'undan KISA
RAG_EXPOSE_DOCS=0               # 1 -> /docs, /redoc, /openapi.json acilir
RAG_ALLOWED_HOSTS=*             # virgullu liste; '*' -> Host dogrulanmaz
RAG_CORS_ORIGINS=               # bos -> CORS basligi HIC gonderilmez (guvenli varsayilan)
RAG_GRACEFUL_SHUTDOWN_S=20      # SIGTERM sonrasi ucusta olan istekler icin sure

# --- Sayfa hizali chunk'lama (#53) ---
# 1 = her child chunk TEK sayfaya bagli (atif fazladan sayfa gostermez).
# 0 = eski davranis (child'larin %63,4'u sayfa asiyordu; precision_page tavani 0,723).
# eval ve uretim AYNI anahtari okur. Ablation: outputs/EXP-011-chunk-ablation/
RAG_CHUNK_PAGE_ALIGNED=1

# --- LLM dayanikliligi (#78, EXP-010/OPS-06) ---
# Olculen LLM p50'leri 1,94-10,44 s; eski varsayilan 120 s SAVUNULAMAZDI.
LLM_TIMEOUT_S=30                # tek cagri zaman asimi
LLM_MAX_ATTEMPTS=3              # yeniden deneme (yalniz 429/5xx/timeout)
LLM_RETRY_BASE_S=0.5            # ustel bekleme tabani (jitter'li)
LLM_RETRY_MAX_S=8.0             # bekleme tavani
LLM_REQUEST_BUDGET_S=45         # istek basina toplam sure butcesi
LLM_BREAKER_THRESHOLD=5         # ardisik hata -> devre kesici acilir
LLM_BREAKER_COOLDOWN_S=30       # kesicinin yari-acik hale gecme suresi

# --- Maliyet tavani (#79, EXP-010/OPS-05) ---
# 0 = kapali. Uretimde EN AZ kullanici/gun tavani doldurulmalidir.
RAG_USER_DAILY_USD=0            # kullanici basina gunluk USD tavani
RAG_TENANT_MONTHLY_USD=0        # kurum basina aylik USD tavani
RAG_BUDGET_SOFT_RATIO=0.8       # bu oranda yumusak alarm (red DEGIL)
# Esikler GERCEK KITAPLA olculerek secildi (10-biyoloji, 194 sayfa):
#   12 sayfa -> 141 birim /  1.812 token /  13 cagri  (bir konu)   GECER
#   30 sayfa -> 363 birim /  7.132 token /  35 cagri  (unite)      GECER
#  194 sayfa -> 2740 birim/ 58.649 token / 252 cagri  (TUM KITAP)  RED
# Birim bir METIN BLOGU'dur (~11,6 blok/sayfa), chunk DEGIL.
RAG_MAX_TOKENS_PER_REQUEST=10000  # ASIL olcut: para token'da harcaniyor
RAG_MAX_UNITS_PER_REQUEST=400     # ucuz on-eleme
RAG_MAX_LLM_CALLS_PER_REQUEST=40  # ucuz on-eleme

# --- Maliyet defteri (#84, EXP-010/OPS-04) ---
# 1 yaparsan `record()` her cagrida Maliyet.md'yi BASTAN YAZAR. Olculdu:
# 50.000 satirda +745 ms ve lineer buyuyor; flock sureclr arasinda
# serilestiriyor. Uretimde KAPALI kalmali; render icin:
#   .venv/bin/python -m src.costlog render
HEZARFEN_COST_RENDER=0

# --- Model surumu pinleme (#80, EXP-010/OPS-07) ---
# Bos birakilirsa her indirme depo HEAD'ini alir; yayinci agirligi
# guncellerse UYGULAMA SESSIZCE BASKA BIR MODELE GECER ve olculmus butun
# sayilar (kapi degerleri dahil) o modele ait olmaktan cikar.
# Uretimde bir commit sha'si verilmelidir.
HEZARFEN_EMBED_REVISION=
HEZARFEN_RERANK_REVISION=

# --- Cevap cache (#83, EXP-010/OPS-11) ---
# BOS = cache KAPALI (varsayilan). Acmak bir davranis degisikligidir; ayrica
# #77'ye gore corpus_version olmadan TEHLIKELIDIR (silinmis kaynaga atif).
# Dosya yolu verilirse WAL acilir ve boyut tavani uygulanir.
RAG_CACHE_PATH=
RAG_CACHE_MAX_BYTES=536870912   # 512 MB; asilinca en eskiler atilir (LRU)
RAG_CACHE_TTL_S=3600

# --- Kaynak silme izi (#76, KVKK) ---
# Bos = iz tutulmaz; silme yine calisir ama KANITLANAMAZ.
# "Sildim" demek yetmez; ne zaman neyin silindigi gosterilebilmeli.
HEZARFEN_DELETION_LOG=

# --- Istek izi (#85, EXP-010/OPS-12) ---
# Bos = iz KAPALI. Acikken her istek JSONL'e yazilir.
# Sorgu METNI YAZILMAZ (#49/KVKK) -- yalniz uzunluk + kisa hash.
# Ornekleme yogun trafikte diski korur; CEKIMSER ve HATALI istekler
# ornekleme oraninden BAGIMSIZ olarak HER ZAMAN yazilir.
HEZARFEN_TRACE_PATH=
HEZARFEN_TRACE_SAMPLE=1.0

# --- Cok-turlu rewrite (#87, EXP-010/OPS-14) ---
# API-CONTRACT `history` alanini vaat ediyordu ama kod onu SESSIZCE ATIYORDU
# (build_service hic rewriter gecirmiyordu). Artik bagli.
# Maliyet: gecmisli her soruda BIR EK LLM cagrisi (~$0.0002).
RAG_REWRITE_HISTORY=1

# --- Gomme / rerank saglayicisi (#96) ------------------------------------
# VARSAYILAN: local. Olculmus butun kalite sayilari (EXP-011/013/017/018)
# yerel BGE-M3 + BGE-reranker-v2-m3 yoluna aittir.
#
# NEDEN API secenegi var: rerank, GPU'yu isteyen TEK parca. CPU'da olculdu:
#   sorgu embed 0,122 s | arama ms | rerank 40 aday 95,9 s | LLM ~2-3 s
# Rerank uzak servise tasinirsa CPU sorgu tarafinda yeterli olur.
RAG_EMBED_PROVIDER=local          # local | api
RAG_RERANK_PROVIDER=local         # local | api | off

# API gomme (OpenAI-uyumlu /v1/embeddings). DIKKAT: yalniz dense doner,
# BGE-M3'un SPARSE ayagi kaybolur ve golden set olcumleri gecersizlesir.
#RAG_EMBED_API_BASE=https://integrate.api.nvidia.com/v1
#RAG_EMBED_MODEL=nvidia/nemotron-3-embed-1b
#RAG_EMBED_API_KEY=
#RAG_EMBED_API_KEY_ENV=NVIDIA_API_KEY     # baska bir degiskenden okumak icin

# API rerank (Cohere/Jina uyumlu: results[].index + relevance_score).
#RAG_RERANK_API_URL=https://api.cohere.com/v2/rerank
#RAG_RERANK_MODEL=rerank-v3.5
#RAG_RERANK_API_KEY=

# Cekimserlik esigi yerel BGE skor dagilimi uzerinde olculdu (EXP-017).
# Baska bir rerank saglayicisiyla kapi ANLAMSIZ olur; servis acilista HATA
# verir. Secenekler: esigi yeniden kalibre et, RAG_ABSTAIN_SCORE=0 ile kapiyi
# bilerek kapat, ya da riski kabul et:
#RAG_ALLOW_UNCALIBRATED_ABSTAIN=1

# --- Cok-korpus (#86) ----------------------------------------------------
# Bos birakilirsa tek BOOK_PATH okunur (eski davranis). Liste verilirse servis
# birden cok derse cevap verir; sohbette ders `options.ders` ile secilir.
# OLCULDU (RTX 4060, gercek /rag/chat): soguk dersin ILK sorusu 0,00 s'de
# "hazirlaniyor" doner (eskiden HTTP 504), korpus arkada kurulur
# (10/biyoloji 55 s, 10/kimya 171 s), sonraki sorular 4-10 s.
#RAG_CORPORA=10/biyoloji,10/kimya,10/cografya    # ya da: all
#RAG_WARM_CORPORA=all        # acilista isit (demo oncesi); bos = tamamen tembel
#RAG_MAX_CORPORA=0           # bellek valfi; 0 = sinirsiz (#75 cozulene kadar
                             # RSS korpus sayisiyla lineer buyur)
